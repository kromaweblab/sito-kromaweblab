---
// Pagina provvisoria per le voci del menu non ancora costruite:
// evita link rotti nell'anteprima. Si sostituisce con la pagina vera.
// Anche qui in fondo c'è la Chiusura: i recapiti non stanno più nel piè di
// pagina, e nessuna pagina deve restare senza.

import Base from '../layout/Base.astro';
import Chiusura from '../sezioni/Chiusura.astro';
import { DA_SCRIVERE } from '../dati/sito';

interface Props {
  titolo: string;
}

const { titolo } = Astro.props;
---

<Base titolo={titolo} descrizione={DA_SCRIVERE}>
  <div class="segnaposto">
    <h1>{titolo}</h1>
    <p>{DA_SCRIVERE}</p>
    <p class="nota">Pagina in costruzione.</p>
  </div>
  <Chiusura />
</Base>

<style>
  .segnaposto {
    max-width: var(--kroma-larghezza);
    margin: 0 auto;
    padding: var(--kroma-spazio-10) var(--kroma-spazio-2);
  }

  h1 {
    margin: 0 0 var(--kroma-spazio-3);
    font-size: var(--kroma-testo-xxl);
    line-height: 1;
  }

  .nota {
    font-size: var(--kroma-testo-s);
    color: var(--kroma-testo-tenue);
  }
</style>
