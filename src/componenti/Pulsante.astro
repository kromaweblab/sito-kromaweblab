---
// Pulsante del sito. È sempre un link (<a>): porta a un'altra pagina.
// Per le azioni dentro la pagina (es. inviare un modulo) si usa <button>.
//
//   <Pulsante href="/contatti">Fissa un primo incontro</Pulsante>
//   <Pulsante href="/siti" variante="secondario">Come facciamo i siti</Pulsante>

interface Props {
  href: string;
  /** primario = arancione, per l'azione principale; secondario = solo il bordo. */
  variante?: 'primario' | 'secondario';
}

const { href, variante = 'primario' } = Astro.props;
---

<a href={href} class:list={['pulsante', variante]}>
  <slot />
</a>

<style>
  .pulsante {
    display: inline-flex;
    align-items: center;
    gap: var(--kroma-spazio-1);
    padding: var(--kroma-spazio-2) var(--kroma-spazio-3);
    border: var(--kroma-linea-spessa) solid var(--kroma-testo);
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition:
      background-color var(--kroma-durata),
      color var(--kroma-durata),
      border-color var(--kroma-durata),
      transform var(--kroma-durata) var(--kroma-curva);
  }

  .primario {
    background: var(--kroma-arancione);
    border-color: var(--kroma-arancione);
    color: var(--kroma-su-arancione);
  }

  .primario:hover {
    background: var(--kroma-testo);
    border-color: var(--kroma-testo);
    color: var(--kroma-nero);
  }

  .secondario {
    background: transparent;
    color: var(--kroma-testo);
  }

  .secondario:hover {
    background: var(--kroma-testo);
    color: var(--kroma-nero);
  }

  /* Al clic il pulsante "scende" di un pixel, come un tasto. */
  .pulsante:active {
    transform: translateY(2px);
  }
</style>
