---
// Piè di pagina di tutte le pagine: chi siamo in una riga, contatti
// (WhatsApp compreso) e menu. I dati mancanti restano [DA SCRIVERE].

import { sito, numeriWhatsapp, linkChat, DA_SCRIVERE } from '../dati/sito';
import { vociMenu, voceContatti } from '../dati/navigazione';

const anno = new Date().getFullYear();
---

<footer class="piede">
  <div class="interno">
    <div class="chi">
      <img src="/brand/kwl-su-scuro.svg" width="143" height="39" alt="Kroma Web Lab" />
      <p>Siti, gestionali e app su misura. Da Scicli, per attività in tutta Italia.</p>
    </div>

    <div class="contatti">
      <h2>Scrivici</h2>
      <dl>
        <dt>WhatsApp</dt>
        <dd>
          {numeriWhatsapp.map((w) => (
            <a href={linkChat(w.numero)} class="whatsapp">
              {w.nome} <span class="numero">{w.visibile}</span>
            </a>
          ))}
        </dd>
        <dt>Email</dt>
        <dd>{sito.email ? <a href={`mailto:${sito.email}`}>{sito.email}</a> : DA_SCRIVERE}</dd>
        <dt>Dove</dt>
        <dd>
          {sito.comune} ({sito.siglaProvincia})
        </dd>
      </dl>
    </div>

    <nav class="collegamenti" aria-label="Pagine del sito">
      <ul>
        {[...vociMenu, voceContatti].map((voce) => (
          <li>
            <a href={voce.href}>{voce.testo}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <p class="dato">
    © {anno} {sito.nome} · {sito.comune} ({sito.siglaProvincia}) ·
    <a href={sito.privacy}>Informativa privacy</a>
  </p>
</footer>

<style>
  .piede {
    background: var(--kroma-nero);
    color: var(--kroma-carta);
    padding: var(--kroma-spazio-8) var(--kroma-spazio-2) var(--kroma-spazio-4);
  }

  .interno {
    display: grid;
    gap: var(--kroma-spazio-6);
    max-width: var(--kroma-larghezza);
    margin: 0 auto;
  }

  .chi p {
    margin: var(--kroma-spazio-3) 0 0;
    max-width: 36ch;
    color: var(--kroma-testo-tenue-su-scuro);
  }

  h2 {
    margin: 0 0 var(--kroma-spazio-2);
    font-size: var(--kroma-testo-l);
  }

  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--kroma-spazio-1) var(--kroma-spazio-3);
    margin: 0;
  }

  dt {
    font-family: var(--kroma-font-mono);
    font-size: var(--kroma-testo-s);
    color: var(--kroma-testo-tenue-su-scuro);
    padding-top: 2px;
  }

  dd {
    margin: 0;
  }

  a {
    color: var(--kroma-carta);
    text-decoration-color: var(--kroma-arancione);
    text-decoration-thickness: var(--kroma-linea-spessa);
    transition: color var(--kroma-durata);
  }

  a:hover {
    color: var(--kroma-arancione);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--kroma-spazio-1);
  }

  .whatsapp {
    display: block;
  }

  .numero {
    font-family: var(--kroma-font-mono);
    font-variant-numeric: tabular-nums;
  }

  .collegamenti a {
    text-decoration: none;
    font-weight: 500;
  }

  .dato {
    max-width: var(--kroma-larghezza);
    margin: var(--kroma-spazio-8) auto 0;
    padding-top: var(--kroma-spazio-2);
    border-top: var(--kroma-linea-sottile) solid var(--kroma-linea-su-scuro);
    font-family: var(--kroma-font-mono);
    font-size: var(--kroma-testo-s);
    color: var(--kroma-testo-tenue-su-scuro);
  }

  /* Griglia asimmetrica da computer: la colonna "chi" è più larga. */
  @media (min-width: 960px) {
    .piede {
      padding-inline: var(--kroma-spazio-4);
    }

    .interno {
      grid-template-columns: 2fr 1.5fr 1fr;
    }
  }
</style>
