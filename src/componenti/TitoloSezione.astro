---
// Titolo di sezione (direzione Officina): Geist, stretto, senza
// decorazioni davanti. Il giallo resta per il marchio e per ciò che chiede
// attenzione.
//
//   <TitoloSezione id="problema-titolo">Una giornata tipo</TitoloSezione>

interface Props {
  /** Serve per collegare il titolo alla sua <section> con aria-labelledby. */
  id: string;
}

const { id } = Astro.props;
---

<h2 id={id}>
  <slot />
</h2>

<style>
  h2 {
    margin: 0;
    font-size: var(--kroma-testo-xl);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1.05;
    text-wrap: balance;
  }
</style>
