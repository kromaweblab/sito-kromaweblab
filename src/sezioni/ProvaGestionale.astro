---
// Cornice della sezione "Provalo": titolo, riga d'introduzione e spazio
// per l'isola, che la pagina inserisce nello <slot />.
//
//   <ProvaGestionale>
//     <SquadraUfficio client:visible />
//   </ProvaGestionale>
//
// Dal 05/10/2026 l'isola è la prova "dal campo all'ufficio" (telefono
// dell'operatore e computer dell'ufficio collegati), al posto della lavagna
// di prenotazioni di Andrea.

import TitoloSezione from '../componenti/TitoloSezione.astro';
---

<section class="prova" aria-labelledby="prova-titolo">
  <div class="testa">
    <TitoloSezione id="prova-titolo">Provalo: dal campo all'ufficio</TitoloSezione>
    <p>
      Fate l'operatore: mandate un rapporto dal telefono e guardate cosa succede in ufficio. Poi,
      dall'ufficio, mandate un lavoro al telefono.
    </p>
  </div>
  <slot />
</section>

<style>
  .prova {
    max-width: var(--kroma-larghezza);
    margin: 0 auto;
    padding: var(--kroma-spazio-8) var(--kroma-spazio-2);
    border-top: var(--kroma-linea-sottile) solid var(--kroma-linea);
  }

  .testa {
    margin-bottom: var(--kroma-spazio-5);
  }

  .testa p {
    max-width: 52ch;
    margin: var(--kroma-spazio-2) 0 0;
    font-size: var(--kroma-testo-m);
    color: var(--kroma-testo-tenue);
  }

  @media (min-width: 960px) {
    .prova {
      padding: var(--kroma-spazio-12) var(--kroma-spazio-4);
    }
  }
</style>
