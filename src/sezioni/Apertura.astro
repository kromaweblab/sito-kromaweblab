---
// Apertura della home (direzione Officina): il marchio a pixel grande, il
// titolo e due pulsanti.
//
// È l'unico momento animato del sito (scelta C): all'apertura i pixel del
// marchio arrivano da punti sparsi e si compongono, poi il cursore giallo
// lampeggia qualche volta. Tutto in CSS, nessun JavaScript. Con "riduci
// movimento" attivo nel telefono o nel computer il marchio è già fermo e
// composto.

import Pulsante from '../componenti/Pulsante.astro';

/** Le celle del marchio (coordinate in CLAUDE.md), con il loro ruolo. */
type Ruolo = 'base' | 'w' | 'l' | 'giallo';
// prettier-ignore
const K: [number, number][] = [
  [0, 0], [0, 1], [0, 2], [0, 3], [0, 4], [1, 0], [1, 1], [1, 2],
  [1, 3], [1, 4], [2, 2], [3, 1], [3, 3], [4, 0], [4, 4],
];
// prettier-ignore
const W: [number, number][] = [
  [0, 0], [0, 1], [0, 2], [0, 3], [1, 4], [2, 2],
  [2, 3], [3, 4], [4, 0], [4, 1], [4, 2], [4, 3],
];
// prettier-ignore
const L: [number, number][] = [[0, 0], [0, 1], [0, 2], [0, 3], [0, 4], [1, 4], [2, 4], [3, 4]];

const celle: { c: number; r: number; ruolo: Ruolo }[] = [
  ...K.map(([c, r]) => ({ c, r, ruolo: (c === 2 && r === 2 ? 'giallo' : 'base') as Ruolo })),
  ...W.map(([c, r]) => ({ c: c + 6, r, ruolo: 'w' as Ruolo })),
  ...L.map(([c, r]) => ({ c: c + 12, r, ruolo: 'l' as Ruolo })),
];

// Da dove parte ogni pixel: un punto "a caso" ma sempre uguale (calcolato
// durante la build, così l'HTML è identico a ogni pubblicazione).
const partenza = (i: number) => ({
  dx: Math.round(Math.sin(i * 12.9898) * 220),
  dy: Math.round(Math.cos(i * 78.233) * 150),
});
---

<section class="apertura" aria-labelledby="apertura-titolo">
  <svg class="marchio" viewBox="-8 -8 302 94" role="img" aria-label="Kroma Web Lab">
    {celle.map(({ c, r, ruolo }, i) => {
      const { dx, dy } = partenza(i);
      return (
        <rect
          class:list={['pixel', ruolo]}
          style={`--i:${i};--dx:${dx}px;--dy:${dy}px`}
          x={c * 16}
          y={r * 16}
          width="14"
          height="14"
        />
      );
    })}
    <rect
      class="pixel giallo cursore"
      style={`--i:${celle.length};--dx:120px;--dy:-90px`}
      x="272"
      y="64"
      width="14"
      height="14"
    ></rect>
  </svg>

  <h1 id="apertura-titolo">Software per chi lavora con una squadra.</h1>
  <p class="sotto">
    Web app, siti e gestionali per aziende della provincia di Ragusa e di tutta Italia. Li
    progettiamo, li costruiamo e li seguiamo nel tempo, in due, da Scicli.
  </p>
  <div class="azioni">
    <Pulsante href="/contatti">Fissa un primo incontro</Pulsante>
    <Pulsante href="/lavori" variante="secondario">
      Vedi i lavori
    </Pulsante>
  </div>
</section>

<style>
  .apertura {
    display: grid;
    gap: var(--kroma-spazio-4);
    max-width: var(--kroma-larghezza);
    margin: 0 auto;
    padding: var(--kroma-spazio-6) var(--kroma-spazio-2) var(--kroma-spazio-10);
  }

  /* ---------- Il marchio ---------- */

  .marchio {
    width: min(100%, 640px);
    height: auto;
    overflow: visible;
  }

  .pixel {
    transform-box: fill-box;
    transform-origin: center;
  }

  .base {
    fill: var(--kroma-bianco);
  }

  .w {
    fill: var(--kroma-arancione);
  }

  .l {
    fill: var(--kroma-verde);
  }

  .giallo {
    fill: var(--kroma-giallo);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pixel {
      animation: componi 900ms var(--kroma-curva) both;
      /* Ogni pixel parte un attimo dopo il precedente. */
      animation-delay: calc(var(--i) * 18ms + 120ms);
    }

    .cursore {
      animation:
        componi 900ms var(--kroma-curva) both,
        lampeggia 500ms steps(1) 6;
      animation-delay: calc(var(--i) * 18ms + 120ms), 1700ms;
    }
  }

  @keyframes componi {
    from {
      opacity: 0;
      transform: translate(var(--dx), var(--dy)) scale(0.4);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes lampeggia {
    50% {
      opacity: 0;
    }
  }

  /* ---------- Testo ---------- */

  h1 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2.75rem, 9vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .sotto {
    max-width: 50ch;
    margin: 0;
    font-size: var(--kroma-testo-m);
    color: var(--kroma-testo-tenue);
  }

  .azioni {
    display: flex;
    flex-wrap: wrap;
    gap: var(--kroma-spazio-2);
  }

  @media (min-width: 960px) {
    .apertura {
      gap: var(--kroma-spazio-5);
      padding: var(--kroma-spazio-10) var(--kroma-spazio-4) var(--kroma-spazio-16);
    }

    .sotto {
      font-size: var(--kroma-testo-l);
      line-height: 1.4;
    }
  }
</style>
