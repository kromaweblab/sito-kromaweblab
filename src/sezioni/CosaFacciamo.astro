---
// "Cosa facciamo": viene subito dopo il gestionale dimostrativo e allarga
// lo sguardo. Non elenca i servizi (lo fa già l'apertura) ma i lavori di
// tutti i giorni che risolviamo, ognuno collegato al servizio giusto.
// Quattro righe su sei sono gestionali: il servizio principale resta in
// primo piano senza dimenticare app e siti.

import TitoloSezione from '../componenti/TitoloSezione.astro';
import { servizi, type Servizio } from '../dati/servizi';

const cicli: { lavoro: string; dettaglio: string; servizio: Servizio['id'] }[] = [
  { lavoro: 'Prenotazioni', dettaglio: 'tavoli, camere, appuntamenti', servizio: 'gestionali' },
  { lavoro: 'Ordini', dettaglio: 'dal cliente al magazzino', servizio: 'gestionali' },
  {
    lavoro: 'Magazzino',
    dettaglio: 'giacenze che si aggiornano da sole',
    servizio: 'gestionali',
  },
  { lavoro: 'Turni', dettaglio: 'chi lavora, quando, dove', servizio: 'gestionali' },
  {
    lavoro: 'La squadra',
    dettaglio: "rapporti e programma, dal campo all'ufficio",
    servizio: 'web-app',
  },
  {
    lavoro: 'Farti trovare',
    dettaglio: 'un sito che dice chi sei e come contattarti',
    servizio: 'siti',
  },
];

const servizioDa = (id: Servizio['id']) => servizi.find((s) => s.id === id)!;
---

<section class="cosa" aria-labelledby="cosa-titolo">
  <div class="testa">
    <TitoloSezione id="cosa-titolo">Non solo prenotazioni</TitoloSezione>
    <p>Quella che hai provato è una lavagna di prenotazioni. Lo stesso si può fare per:</p>
  </div>

  <ul>
    {cicli.map((ciclo) => {
      const servizio = servizioDa(ciclo.servizio);
      return (
        <li>
          <a href={servizio.href}>
            <strong>{ciclo.lavoro}</strong>
            <span class="dettaglio">{ciclo.dettaglio}</span>
            <span class="servizio">
              {servizio.nome} <span aria-hidden="true">→</span>
            </span>
          </a>
        </li>
      );
    })}
  </ul>

  <a href="/servizi" class="tutti">
    Tutti i servizi <span aria-hidden="true">→</span>
  </a>
</section>

<style>
  .cosa {
    max-width: var(--kroma-larghezza);
    margin: 0 auto;
    padding: var(--kroma-spazio-8) var(--kroma-spazio-2);
    border-top: var(--kroma-linea-sottile) solid var(--kroma-linea);
  }

  .testa p {
    max-width: 52ch;
    margin: var(--kroma-spazio-2) 0 0;
    font-size: var(--kroma-testo-l);
    line-height: 1.35;
  }

  ul {
    list-style: none;
    margin: var(--kroma-spazio-5) 0 0;
    padding: 0;
    border-top: var(--kroma-linea-sottile) solid var(--kroma-linea);
  }

  li {
    border-bottom: var(--kroma-linea-sottile) solid var(--kroma-linea);
  }

  /* Tutta la riga è il link. Da telefono: lavoro e servizio in alto,
     il dettaglio sotto. */
  li a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--kroma-spazio-1) var(--kroma-spazio-2);
    align-items: baseline;
    padding: var(--kroma-spazio-3) var(--kroma-spazio-1);
    text-decoration: none;
    transition: background-color var(--kroma-durata);
  }

  strong {
    font-size: var(--kroma-testo-l);
    line-height: 1.2;
  }

  .dettaglio {
    grid-column: 1 / -1;
    grid-row: 2;
    color: var(--kroma-testo-tenue);
  }

  .servizio {
    font-family: var(--kroma-font-mono);
    font-size: var(--kroma-testo-s);
    white-space: nowrap;
  }

  .servizio span,
  .tutti span {
    display: inline-block;
    transition: transform var(--kroma-durata);
  }

  li a:hover {
    background: var(--kroma-carta-hover);
  }

  li a:hover .servizio span,
  .tutti:hover span {
    transform: translateX(4px);
  }

  .tutti {
    display: inline-flex;
    gap: var(--kroma-spazio-1);
    margin-top: var(--kroma-spazio-4);
    font-weight: 700;
    text-decoration-color: var(--kroma-arancione-scuro);
    text-decoration-thickness: var(--kroma-linea-spessa);
    text-underline-offset: 0.25em;
  }

  /* Da computer: lavoro | dettaglio | servizio su una riga. */
  @media (min-width: 960px) {
    .cosa {
      padding: var(--kroma-spazio-12) var(--kroma-spazio-4);
    }

    li a {
      grid-template-columns: calc(2 * var(--kroma-spazio-16)) 1fr auto;
      gap: var(--kroma-spazio-3);
      padding-inline: var(--kroma-spazio-2);
    }

    .dettaglio {
      grid-column: auto;
      grid-row: auto;
      font-size: var(--kroma-testo-l);
    }
  }
</style>
