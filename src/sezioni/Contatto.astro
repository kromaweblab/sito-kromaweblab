---
// "Contatto": l'ultima sezione della home. Solo l'invito: nessun modulo qui
// (i moduli stanno in /contatti, con il configuratore di Andrea).
// Due strade: la pagina contatti, oppure WhatsApp. Finché il numero non
// c'è, al posto del pulsante WhatsApp si vede il segnaposto.

import TitoloSezione from '../componenti/TitoloSezione.astro';
import Pulsante from '../componenti/Pulsante.astro';
import { sito, linkWhatsapp, DA_SCRIVERE } from '../dati/sito';
---

<section class="contatto" aria-labelledby="contatto-titolo">
  <TitoloSezione id="contatto-titolo">Raccontaci come lavori oggi.</TitoloSezione>

  <p class="frase">
    Di persona se sei in zona, in videochiamata da tutta Italia. Ci racconti la tua attività, noi ti
    diciamo cosa si può fare.
  </p>

  <div class="azioni">
    <Pulsante href="/contatti">Raccontaci la tua attività</Pulsante>
    {linkWhatsapp ? (
      <Pulsante href={linkWhatsapp} variante="secondario">
        Scrivici su WhatsApp
      </Pulsante>
    ) : (
      <span class="segnaposto">WhatsApp {DA_SCRIVERE}</span>
    )}
  </div>

  <p class="dati">
    {sito.comune} ({sito.siglaProvincia}) · di persona in provincia di {sito.provincia} · a distanza
    in tutta Italia
  </p>
</section>

<style>
  .contatto {
    max-width: var(--kroma-larghezza);
    margin: 0 auto;
    padding: var(--kroma-spazio-10) var(--kroma-spazio-2);
    border-top: var(--kroma-linea-sottile) solid var(--kroma-linea);
  }

  /* Il titolo di questa sezione è più grande degli altri: è la chiusura. */
  .contatto :global(h2) {
    max-width: 16ch;
    font-size: var(--kroma-testo-xxl);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  .frase {
    max-width: 44ch;
    margin: var(--kroma-spazio-3) 0 0;
    font-size: var(--kroma-testo-l);
    line-height: 1.35;
  }

  .azioni {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--kroma-spazio-1);
    margin-top: var(--kroma-spazio-5);
  }

  .segnaposto {
    padding: var(--kroma-spazio-2) var(--kroma-spazio-3);
    border: var(--kroma-linea-spessa) dashed var(--kroma-testo-tenue);
    color: var(--kroma-testo-tenue);
    font-family: var(--kroma-font-mono);
    font-size: var(--kroma-testo-s);
  }

  .dati {
    margin: var(--kroma-spazio-5) 0 0;
    font-family: var(--kroma-font-mono);
    font-size: var(--kroma-testo-s);
    color: var(--kroma-testo-tenue);
  }

  @media (min-width: 960px) {
    .contatto {
      padding: var(--kroma-spazio-16) var(--kroma-spazio-4);
    }
  }
</style>
