---
// Pagina /contatti: titolo, due righe su cosa succede, poi due colonne:
// a sinistra lo spazio per il configuratore di Andrea, a destra i contatti
// diretti. "Cosa succede dopo" sta dentro il configuratore, non qui.
//
// Il configuratore entra nello <slot />, come il gestionale in home:
//
//   <PaginaContatti>
//     <Configuratore client:visible />
//     <ModuloRichiestaNascosto />
//   </PaginaContatti>
//
// Finché lo slot è vuoto si vede il testo di riserva (dentro <slot>).

import { sito, numeriWhatsapp, linkChat, DA_SCRIVERE } from '../dati/sito';
---

<div class="contatti">
  <header class="testa">
    <h1>Raccontaci la tua attività.</h1>
    <p>
      Ti ricontattiamo entro {sito.tempoRisposta}. Il primo incontro lo scegli tu: {sito.colloquio}.
    </p>
  </header>

  <div class="colonne">
    <section class="spazio-configuratore" aria-label="Richiesta">
      <slot>
        <p class="riserva">qui andrà il configuratore di Andrea</p>
      </slot>
    </section>

    <aside class="diretti" aria-labelledby="diretti-titolo">
      <h2 id="diretti-titolo">Scrivici direttamente</h2>
      <dl>
        <dt>WhatsApp</dt>
        <dd>
          <ul>
            {numeriWhatsapp.map((w) => (
              <li>
                <a href={linkChat(w.numero)}>
                  {w.nome} <span class="numero">{w.visibile}</span>
                </a>
              </li>
            ))}
          </ul>
        </dd>
        <dt>Email</dt>
        <dd>{sito.email ? <a href={`mailto:${sito.email}`}>{sito.email}</a> : DA_SCRIVERE}</dd>
        <dt>Dove</dt>
        <dd>
          {sito.comune} ({sito.siglaProvincia})
        </dd>
      </dl>
    </aside>
  </div>
</div>

<style>
  .contatti {
    max-width: var(--kroma-larghezza);
    margin: 0 auto;
    padding: var(--kroma-spazio-6) var(--kroma-spazio-2) var(--kroma-spazio-10);
  }

  h1 {
    max-width: 14ch;
    margin: 0;
    font-size: var(--kroma-testo-xxl);
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .testa p {
    max-width: 48ch;
    margin: var(--kroma-spazio-3) 0 0;
    font-size: var(--kroma-testo-l);
    line-height: 1.35;
  }

  .colonne {
    display: grid;
    gap: var(--kroma-spazio-6);
    margin-top: var(--kroma-spazio-6);
    padding-top: var(--kroma-spazio-4);
    border-top: var(--kroma-linea-sottile) solid var(--kroma-linea);
  }

  .riserva {
    margin: 0;
    padding: var(--kroma-spazio-6) var(--kroma-spazio-2);
    border: var(--kroma-linea-sottile) dashed var(--kroma-linea);
    font-family: var(--kroma-font-mono);
    font-size: var(--kroma-testo-s);
    text-align: center;
  }

  /* ---------- Contatti diretti ---------- */

  h2 {
    display: flex;
    align-items: baseline;
    gap: var(--kroma-spazio-2);
    margin: 0 0 var(--kroma-spazio-2);
    font-size: var(--kroma-testo-l);
  }

  h2::before {
    content: '';
    flex: none;
    width: var(--kroma-pixel-cella);
    height: var(--kroma-pixel-cella);
    background: var(--kroma-giallo);
  }

  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--kroma-spazio-2) var(--kroma-spazio-3);
    margin: 0;
  }

  dt {
    padding-top: 2px;
    font-family: var(--kroma-font-mono);
    font-size: var(--kroma-testo-s);
    color: var(--kroma-testo-tenue);
  }

  dd {
    margin: 0;
  }

  dd ul {
    display: grid;
    gap: var(--kroma-spazio-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    font-weight: 700;
    text-decoration-color: var(--kroma-arancione-scuro);
    text-decoration-thickness: var(--kroma-linea-spessa);
    text-underline-offset: 0.2em;
    transition: color var(--kroma-durata);
  }

  a:hover {
    color: var(--kroma-arancione-testo);
  }

  .numero {
    font-family: var(--kroma-font-mono);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  /* Da computer: configuratore largo a sinistra, contatti a destra. */
  @media (min-width: 960px) {
    .contatti {
      padding: var(--kroma-spazio-10) var(--kroma-spazio-4) var(--kroma-spazio-16);
    }

    .colonne {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      gap: var(--kroma-spazio-8);
      align-items: start;
    }

    .diretti {
      position: sticky;
      top: var(--kroma-spazio-3);
    }
  }
</style>
