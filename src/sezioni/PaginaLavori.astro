---
// Pagina /lavori (nuova impostazione, 05/10/2026): tutti i lavori nello
// stesso riquadro della home, nella disposizione larga (cornice a sinistra,
// testo a destra), uno sotto l'altro. Ogni riquadro porta al caso completo.
// I dati stanno in src/dati/lavori.ts: gli stessi della home.

import RiquadroLavoro from '../componenti/RiquadroLavoro.astro';
import { lavori } from '../dati/lavori';
---

<div class="lavori">
  <header class="testa">
    <h1>Lavori</h1>
    <p>
      Un gestionale che una squadra usa ogni giorno, e due siti. Ogni lavoro ha la sua pagina:
      com'era prima, cosa abbiamo fatto, come si usa oggi.
    </p>
  </header>

  <div class="elenco">
    {lavori.map((lavoro) => (
      <RiquadroLavoro lavoro={lavoro} disposizione="larga" livello={2} />
    ))}
  </div>
</div>

<style>
  .lavori {
    display: grid;
    gap: var(--kroma-spazio-6);
    max-width: var(--kroma-larghezza);
    margin: 0 auto;
    padding: var(--kroma-spazio-6) var(--kroma-spazio-2) var(--kroma-spazio-10);
  }

  h1 {
    margin: 0;
    font-size: var(--kroma-testo-xxl);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .testa p {
    max-width: 52ch;
    margin: var(--kroma-spazio-3) 0 0;
    font-size: var(--kroma-testo-m);
    color: var(--kroma-testo-tenue);
  }

  .elenco {
    display: grid;
    gap: var(--kroma-spazio-3);
  }

  @media (min-width: 960px) {
    .lavori {
      gap: var(--kroma-spazio-8);
      padding: var(--kroma-spazio-10) var(--kroma-spazio-4) var(--kroma-spazio-12);
    }

    .elenco {
      gap: var(--kroma-spazio-4);
    }
  }
</style>
