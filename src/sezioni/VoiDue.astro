---
// "Voi due": subito dopo l'apertura, le due persone dello studio. È la
// prova che dietro il sito ci sono persone vere, e che chi ascolta al primo
// incontro è chi poi costruisce.
//
// Finché non ci sono le foto vere, al loro posto c'è un riquadro che lo
// dice (stesse proporzioni, così la pagina non cambia quando arrivano).

import TitoloSezione from '../componenti/TitoloSezione.astro';
import { squadra } from '../dati/squadra';
---

<section class="voi-due" aria-labelledby="voi-due-titolo">
  <div class="interno">
    <div class="testa">
      <TitoloSezione id="voi-due-titolo">Parlate con chi scrive il codice.</TitoloSezione>
      <p>Siamo in due. Chi vi ascolta al primo incontro è chi poi costruisce l'app.</p>
    </div>

    <ul class="persone">
      {squadra.map((persona) => (
        <li class="persona">
          <div class="foto" role="img" aria-label={`Foto di ${persona.nome}, in arrivo`}>
            <span aria-hidden="true">foto di {persona.nome}</span>
          </div>
          <div class="testo">
            <h3>{persona.nome}</h3>
            <p class="ruolo">{persona.ruolo}</p>
            <p>{persona.frase}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .voi-due {
    background: var(--kroma-superficie);
    border-block: var(--kroma-linea-sottile) solid var(--kroma-linea);
  }

  .interno {
    display: grid;
    gap: var(--kroma-spazio-5);
    max-width: var(--kroma-larghezza);
    margin: 0 auto;
    padding: var(--kroma-spazio-8) var(--kroma-spazio-2);
  }

  .testa p {
    max-width: 44ch;
    margin: var(--kroma-spazio-2) 0 0;
    font-size: var(--kroma-testo-m);
    color: var(--kroma-testo-tenue);
  }

  .persone {
    display: grid;
    gap: var(--kroma-spazio-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .persona {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 9fr);
    gap: var(--kroma-spazio-3);
    align-items: start;
  }

  /* Segnaposto della foto: stesse proporzioni della foto vera (4:5). */
  .foto {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    max-width: 100%;
    padding: var(--kroma-spazio-2);
    border: var(--kroma-linea-sottile) dashed var(--kroma-bordo);
    background: var(--kroma-fondo);
    color: var(--kroma-testo-tenue);
    font-size: var(--kroma-testo-s);
    text-align: center;
  }

  h3 {
    margin: 0;
    font-size: var(--kroma-testo-l);
  }

  .testo p {
    margin: var(--kroma-spazio-1) 0 0;
    color: var(--kroma-testo-tenue);
  }

  .testo .ruolo {
    color: var(--kroma-testo);
    font-weight: 500;
  }

  @media (min-width: 960px) {
    .interno {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--kroma-spazio-8);
      padding: var(--kroma-spazio-12) var(--kroma-spazio-4);
    }

    .persone {
      grid-template-columns: 1fr 1fr;
      gap: var(--kroma-spazio-4);
    }

    .persona {
      grid-template-columns: 1fr;
    }
  }
</style>
