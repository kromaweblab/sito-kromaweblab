---
// "Un lavoro": Vivai Cintoli in evidenza, con una ricostruzione di quello
// che vede ciascun ruolo nell'app; sotto, gli altri due lavori in una riga.
//
// La ricostruzione:
// - è disegnata in HTML dal codice dell'app vera, con DATI DI ESEMPIO:
//   nessun nome di dipendente, prodotto o dato reale del vivaio;
// - usa i colori dell'app (token --kroma-vivai-*) e i suoi angoli tondi:
//   è "una fotografia" dell'app del cliente, per questo fa eccezione alle
//   regole di stile del sito (DECISIONI.md);
// - il selettore dei ruoli funziona senza JavaScript, come quello
//   dell'apertura: pulsanti radio + CSS :has().

import TitoloSezione from '../componenti/TitoloSezione.astro';
import Pulsante from '../componenti/Pulsante.astro';
import { lavori, usoVivai } from '../dati/lavori';

const [vivai, ...altri] = lavori;
---

<section class="lavoro" aria-labelledby="lavoro-titolo">
  <div class="testa">
    <TitoloSezione id="lavoro-titolo">{vivai.nome}</TitoloSezione>
    <p class="dati">
      {vivai.tipo} · in uso da {usoVivai.inUsoDa} · {usoVivai.persone}
    </p>
    <p class="frase">{vivai.descrizione}</p>
  </div>

  <fieldset class="ruoli">
    <legend class="solo-lettori">Cosa vede ogni ruolo nell'app</legend>
    <input type="radio" name="ruolo-vivai" id="ruolo-ufficio" checked />
    <label for="ruolo-ufficio">
      <span class="quadretto" aria-hidden="true"></span>
      <span>
        Ufficio e admin<small>dal computer</small>
      </span>
    </label>
    <input type="radio" name="ruolo-vivai" id="ruolo-operatore" />
    <label for="ruolo-operatore">
      <span class="quadretto" aria-hidden="true"></span>
      <span>
        Operatore<small>dal telefono</small>
      </span>
    </label>
  </fieldset>

  <div class="schermata schermata-ufficio">
    <p class="spiega">
      L'ufficio riceve i rapporti di tutti e scarica il PDF con le ore già sommate. Nel programma di
      domani vede subito chi è in permesso, quale mezzo è fermo e chi è già impegnato.
    </p>
    <div class="schermi">
      <figure class="app">
        <div class="barra">
          Rapporti di oggi <span>Ufficio</span>
        </div>
        <div class="corpo">
          <p class="riga">
            Rossi{' '}
            <span class="valore">
              8,0 h <span class="stato">Inviato</span>
            </span>
          </p>
          <p class="riga">
            Bianchi{' '}
            <span class="valore">
              7,5 h <span class="stato pieno">Approvato</span>
            </span>
          </p>
          <p class="riga">
            Squadra Colombo · 3 persone
            <span class="valore">
              24,0 h <span class="stato">Ricevuto</span>
            </span>
          </p>
          <p class="riga totale">
            Totale del giorno <span class="valore">39,5 h</span>
          </p>
          <p class="bottone">Scarica PDF</p>
        </div>
      </figure>
      <figure class="app">
        <div class="barra">Programma di domani</div>
        <div class="corpo">
          <p class="riga">
            <span>
              <b>Riga 1</b> · Potatura siepi
            </span>
            <span class="tenue">Rossi, Bianchi</span>
          </p>
          <p class="riga">
            <span>
              <b>Riga 2</b> · Trapianto serra 3
            </span>
          </p>
          <p class="riga">
            <span>
              Rossi <span class="etichetta errore">occupato: riga 1</span>
            </span>
          </p>
          <p class="riga">
            <span>
              Esposito <span class="etichetta avviso">in permesso</span>
            </span>
          </p>
          <p class="riga">
            <span>
              Trattore 2 <span class="etichetta avviso">non disponibile</span>
            </span>
          </p>
          <p class="nota-admin">
            Solo gli amministratori creano gli account e scelgono i moduli di ogni operatore.
          </p>
        </div>
      </figure>
    </div>
  </div>

  <div class="schermata schermata-operatore">
    <p class="spiega">
      Ogni operatore vede solo i moduli che gli servono: li sceglie l'ufficio, persona per persona.
      A fine turno manda il rapporto da qui.
    </p>
    <div class="schermi">
      <figure class="app">
        <div class="barra">
          Vivai Cintoli <span>Operatore Rossi</span>
        </div>
        <div class="corpo">
          <p class="saluto">Benvenuto, Rossi</p>
          <ul class="tessere">
            <li>Rapporto di oggi</li>
            <li>Programma di oggi</li>
            <li>Permessi</li>
            <li>Le mie ore</li>
            <li>Segnalazioni</li>
            <li class="spenta">Trattamenti · nascosto</li>
          </ul>
        </div>
      </figure>
      <figure class="app">
        <div class="barra">Rapporto di oggi</div>
        <div class="corpo">
          <p class="riga">
            Vivaio · Potatura <span class="valore">4,0 h</span>
          </p>
          <p class="riga">
            Vivaio · Irrigazione <span class="valore">2,5 h</span>
          </p>
          <p class="riga">
            Area verde · Cantiere 2 <span class="valore">1,5 h</span>
          </p>
          <p class="riga totale">
            Somma ore righe <span class="valore">8,0 / 8,0 dichiarate</span>
          </p>
          <p class="bottone">Invia all'ufficio</p>
        </div>
      </figure>
    </div>
  </div>

  <p class="avvertenza">ricostruzione dell'app con dati di esempio</p>

  <div class="azioni">
    <Pulsante href={vivai.href} variante="secondario" freccia>
      Leggi il caso completo
    </Pulsante>
  </div>

  <ul class="altri" aria-label="Altri lavori">
    {altri.map((lavoro) => (
      <li>
        <a href={lavoro.href}>
          <strong>{lavoro.nome}</strong>
          <span class="descrizione">{lavoro.descrizione}</span>
          <span class="tipo">
            {lavoro.tipo} <span aria-hidden="true">→</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .lavoro {
    max-width: var(--kroma-larghezza);
    margin: 0 auto;
    padding: var(--kroma-spazio-8) var(--kroma-spazio-2);
    border-top: var(--kroma-linea-sottile) solid var(--kroma-linea);
  }

  .dati {
    margin: var(--kroma-spazio-2) 0 0;
    font-family: var(--kroma-font-mono);
    font-size: var(--kroma-testo-s);
    color: var(--kroma-testo-tenue);
  }

  .frase {
    max-width: 46ch;
    margin: var(--kroma-spazio-2) 0 0;
    font-size: var(--kroma-testo-l);
    line-height: 1.35;
  }

  /* ---------- Selettore dei ruoli ---------- */

  .ruoli {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-width: 0;
    margin: var(--kroma-spazio-5) 0 0;
    padding: 0;
    border: var(--kroma-linea-sottile) solid var(--kroma-linea);
  }

  .ruoli input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .ruoli label {
    display: flex;
    align-items: center;
    gap: var(--kroma-spazio-2);
    padding: var(--kroma-spazio-2);
    background: var(--kroma-carta);
    font-weight: 500;
    line-height: 1.2;
    cursor: pointer;
    transition:
      background-color var(--kroma-durata),
      color var(--kroma-durata);
  }

  #ruolo-operatore + label {
    border-left: var(--kroma-linea-sottile) solid var(--kroma-linea);
  }

  .ruoli small {
    display: block;
    font-family: var(--kroma-font-mono);
    font-size: var(--kroma-testo-s);
    font-weight: 400;
  }

  .quadretto {
    flex: none;
    width: var(--kroma-pixel-cella);
    height: var(--kroma-pixel-cella);
    border: var(--kroma-linea-spessa) solid currentColor;
  }

  .ruoli label:hover {
    background: var(--kroma-carta-hover);
  }

  .ruoli input:checked + label {
    background: var(--kroma-nero);
    color: var(--kroma-carta);
  }

  .ruoli input:checked + label .quadretto {
    background: var(--kroma-giallo);
    border-color: var(--kroma-giallo);
  }

  .ruoli input:focus-visible + label {
    outline: var(--kroma-linea-spessa) solid var(--kroma-arancione-testo);
    outline-offset: calc(-1 * var(--kroma-spazio-1));
  }

  .ruoli input:checked:focus-visible + label {
    outline-color: var(--kroma-giallo);
  }

  /* ---------- Schermate ---------- */

  .schermata {
    border: var(--kroma-linea-sottile) solid var(--kroma-linea);
    border-top: 0;
    background: var(--kroma-carta);
  }

  .schermata + .schermata {
    margin-top: var(--kroma-spazio-4);
  }

  /* Solo se il browser conosce :has(): si vede la schermata del ruolo scelto. */
  @supports selector(:has(a)) {
    .schermata {
      display: none;
    }

    .schermata + .schermata {
      margin-top: 0;
    }

    .lavoro:has(#ruolo-ufficio:checked) .schermata-ufficio,
    .lavoro:has(#ruolo-operatore:checked) .schermata-operatore {
      display: block;
    }
  }

  .spiega {
    margin: 0;
    padding: var(--kroma-spazio-2);
    border-bottom: var(--kroma-linea-sottile) solid var(--kroma-linea);
  }

  .schermi {
    display: grid;
    gap: var(--kroma-spazio-2);
    padding: var(--kroma-spazio-2);
  }

  .avvertenza {
    margin: var(--kroma-spazio-1) 0 0;
    font-family: var(--kroma-font-mono);
    font-size: var(--kroma-testo-s);
    color: var(--kroma-testo-tenue);
  }

  /* ---------- L'app disegnata, nei colori di Vivai Cintoli ---------- */

  .app {
    margin: 0;
    overflow: hidden;
    border: var(--kroma-linea-sottile) solid var(--kroma-vivai-bordo);
    border-radius: var(--kroma-vivai-raggio);
    background: var(--kroma-vivai-fondo);
    color: var(--kroma-vivai-testo);
    font-size: var(--kroma-testo-s);
  }

  .barra {
    display: flex;
    justify-content: space-between;
    gap: var(--kroma-spazio-2);
    padding: var(--kroma-spazio-1) var(--kroma-spazio-2);
    background: var(--kroma-vivai-verde);
    color: var(--kroma-bianco);
    font-weight: 700;
  }

  .barra span {
    font-weight: 400;
  }

  .corpo {
    display: grid;
    gap: var(--kroma-spazio-1);
    padding: var(--kroma-spazio-2);
  }

  .corpo p {
    margin: 0;
  }

  .riga,
  .nota-admin {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--kroma-spazio-1);
    padding: var(--kroma-spazio-1);
    border: var(--kroma-linea-sottile) solid var(--kroma-vivai-bordo);
    border-radius: var(--kroma-vivai-raggio);
    background: var(--kroma-bianco);
  }

  .valore {
    font-family: var(--kroma-font-mono);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .totale {
    background: var(--kroma-vivai-verde-tenue);
    color: var(--kroma-vivai-verde-scuro);
    font-weight: 700;
  }

  .tenue,
  .nota-admin {
    color: var(--kroma-vivai-testo-tenue);
  }

  .nota-admin {
    border-style: dashed;
  }

  .stato,
  .etichetta {
    display: inline-block;
    margin-left: var(--kroma-spazio-1);
    padding: 0 var(--kroma-spazio-1);
    border-radius: var(--kroma-spazio-2);
    font-family: var(--kroma-font-testo);
    font-size: var(--kroma-testo-s);
  }

  .stato {
    background: var(--kroma-vivai-verde-tenue);
    color: var(--kroma-vivai-verde-scuro);
  }

  .stato.pieno {
    background: var(--kroma-vivai-verde);
    color: var(--kroma-bianco);
  }

  .etichetta.avviso {
    background: var(--kroma-vivai-avviso-fondo);
    color: var(--kroma-vivai-avviso-testo);
  }

  .etichetta.errore {
    background: var(--kroma-vivai-errore-fondo);
    color: var(--kroma-vivai-errore-testo);
  }

  .bottone {
    padding: var(--kroma-spazio-1);
    border-radius: var(--kroma-vivai-raggio);
    background: var(--kroma-vivai-verde);
    color: var(--kroma-bianco);
    font-weight: 700;
    text-align: center;
  }

  .saluto {
    font-size: var(--kroma-testo-m);
    font-weight: 700;
  }

  .tessere {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--kroma-spazio-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tessere li {
    padding: var(--kroma-spazio-2) var(--kroma-spazio-1);
    border: var(--kroma-linea-sottile) solid var(--kroma-vivai-bordo);
    border-radius: var(--kroma-vivai-raggio);
    background: var(--kroma-bianco);
    font-weight: 500;
  }

  .tessere .spenta {
    border-style: dashed;
    background: transparent;
    color: var(--kroma-vivai-testo-tenue);
  }

  /* ---------- Chiusura e altri lavori ---------- */

  .azioni {
    margin-top: var(--kroma-spazio-4);
  }

  .altri {
    margin: var(--kroma-spazio-6) 0 0;
    padding: 0;
    list-style: none;
    border-top: var(--kroma-linea-sottile) solid var(--kroma-linea);
  }

  .altri li {
    border-bottom: var(--kroma-linea-sottile) solid var(--kroma-linea);
  }

  .altri a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--kroma-spazio-1) var(--kroma-spazio-2);
    align-items: baseline;
    padding: var(--kroma-spazio-3) var(--kroma-spazio-1);
    text-decoration: none;
    transition: background-color var(--kroma-durata);
  }

  .altri strong {
    font-size: var(--kroma-testo-l);
  }

  .altri .descrizione {
    grid-column: 1 / -1;
    grid-row: 2;
    color: var(--kroma-testo-tenue);
  }

  .altri .tipo {
    font-family: var(--kroma-font-mono);
    font-size: var(--kroma-testo-s);
    white-space: nowrap;
  }

  .altri .tipo span {
    display: inline-block;
    transition: transform var(--kroma-durata);
  }

  .altri a:hover {
    background: var(--kroma-carta-hover);
  }

  .altri a:hover .tipo span {
    transform: translateX(4px);
  }

  /* ---------- Da computer ---------- */

  @media (min-width: 960px) {
    .lavoro {
      padding: var(--kroma-spazio-12) var(--kroma-spazio-4);
    }

    .ruoli label {
      padding: var(--kroma-spazio-2) var(--kroma-spazio-3);
      font-size: var(--kroma-testo-l);
    }

    .spiega {
      padding: var(--kroma-spazio-2) var(--kroma-spazio-3);
    }

    /* Le due schermate affiancate: la prima più stretta, la seconda più larga. */
    .schermi {
      grid-template-columns: 2fr 3fr;
      align-items: start;
      gap: var(--kroma-spazio-3);
      padding: var(--kroma-spazio-3);
    }

    .altri a {
      grid-template-columns: calc(2 * var(--kroma-spazio-16)) 1fr auto;
      gap: var(--kroma-spazio-3);
      padding-inline: var(--kroma-spazio-2);
    }

    .altri .descrizione {
      grid-column: auto;
      grid-row: auto;
    }
  }
</style>
