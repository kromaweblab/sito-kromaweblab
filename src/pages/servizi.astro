---
// Pagina /servizi: i tre servizi e, in fondo, la stessa chiusura della
// home. Qui c'è anche il JSON-LD dei servizi (Service), con solo dati
// veri presi da src/dati: niente prezzi né recensioni.
import Base from '../layout/Base.astro';
import PaginaServizi from '../sezioni/PaginaServizi.astro';
import Chiusura from '../sezioni/Chiusura.astro';
import { offerta } from '../dati/servizi';
import { sito } from '../dati/sito';

const fornitore = { '@type': 'ProfessionalService', name: sito.nome, url: sito.url };
const zona = [
  { '@type': 'City', name: sito.comune },
  { '@type': 'AdministrativeArea', name: `Provincia di ${sito.provincia}` },
  { '@type': 'Country', name: 'Italia' },
];

const datiStrutturati = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Servizi di ${sito.nome}`,
  itemListElement: offerta.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.nome,
      description: s.frase,
      url: new URL(s.href, Astro.site).href,
      provider: fornitore,
      areaServed: zona,
    },
  })),
};
---

<Base
  titolo="Gestionali, siti e manutenzione in provincia di Ragusa"
  descrizione="Gestionali e web app su misura per chi lavora con una squadra, siti per farsi trovare e manutenzione dopo la consegna. Kroma Web Lab, Scicli: di persona o in videochiamata."
>
  <PaginaServizi />
  <Chiusura />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(datiStrutturati)} />
</Base>
