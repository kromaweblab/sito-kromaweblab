---
// Pagina /servizi: i tre servizi e, in fondo, lo stesso invito al contatto
// della home. Qui c'è anche il JSON-LD dei servizi (Service), con solo dati
// veri presi da src/dati: niente prezzi né recensioni.
import Base from '../layout/Base.astro';
import PaginaServizi from '../sezioni/PaginaServizi.astro';
import Contatto from '../sezioni/Contatto.astro';
import { servizi } from '../dati/servizi';
import { sito } from '../dati/sito';

const fornitore = { '@type': 'ProfessionalService', name: sito.nome, url: sito.url };
const zona = [
  { '@type': 'City', name: sito.comune },
  { '@type': 'AdministrativeArea', name: `Provincia di ${sito.provincia}` },
  { '@type': 'Country', name: 'Italia' },
];

const datiStrutturati = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Servizi di ${sito.nome}`,
  itemListElement: servizi.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.nome,
      description: `${s.titolo} ${s.testo}`,
      url: new URL(s.href, Astro.site).href,
      provider: fornitore,
      areaServed: zona,
    },
  })),
};
---

<Base
  titolo="Gestionali, app e siti in provincia di Ragusa"
  descrizione="Gestionali, web app e siti per le attività di Scicli e della provincia di Ragusa. Ci incontriamo di persona o in videochiamata e partiamo da come lavori oggi."
>
  <PaginaServizi />
  <Contatto />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(datiStrutturati)} />
</Base>
