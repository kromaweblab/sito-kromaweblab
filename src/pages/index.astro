---
// Home. Le sezioni si aggiungono qui una alla volta, nell'ordine della
// mappa in CLAUDE.md.
import Base from '../layout/Base.astro';
import Apertura from '../sezioni/Apertura.astro';
import Problema from '../sezioni/Problema.astro';
import ProvaGestionale from '../sezioni/ProvaGestionale.astro';
import CosaFacciamo from '../sezioni/CosaFacciamo.astro';
import UnLavoro from '../sezioni/UnLavoro.astro';
import { GestionaleDimostrativo } from '../isole/gestionale-dimostrativo/GestionaleDimostrativo';
import { DA_SCRIVERE } from '../dati/sito';
---

<Base titolo="Kroma Web Lab — Scicli" descrizione={DA_SCRIVERE}>
  <Apertura />
  <Problema />
  <ProvaGestionale>
    <GestionaleDimostrativo client:visible />
  </ProvaGestionale>
  <CosaFacciamo />
  <UnLavoro />
  <p class="provvisoria">home in costruzione · prossima sezione: contatto</p>
</Base>

<style>
  .provvisoria {
    max-width: var(--kroma-larghezza);
    margin: 0 auto;
    padding: var(--kroma-spazio-4) var(--kroma-spazio-2) var(--kroma-spazio-8);
    border-top: var(--kroma-linea-sottile) solid var(--kroma-linea);
    font-family: var(--kroma-font-mono);
    font-size: var(--kroma-testo-s);
    color: var(--kroma-testo-tenue);
  }
</style>
